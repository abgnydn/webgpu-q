{
  "name": "webgpu-q",
  "version": "0.7.0",
  "description": "WebGPU quantum many-body + chemistry simulator — RHF/UHF/RKS/UKS DFT, MP2/CCSD/CCSD(T)/EOM-CCSD (PySCF-ported, 39× GPU), full polarizability + dispersion stack (TDHF/TDDFT/UKS-TDDFT/C₆), D2 dispersion, Foster-Boys + Pipek-Mezey localization, Molden/Cube/QCSchema/XYZ import/export. Browser-platform stack: Web Worker parallelism (SharedArrayBuffer), embedded Pyodide REPL with PySCF compare, drag-import (XYZ/PDB/MOL/SDF), PWA + offline + IndexedDB history, URL-as-citation. Runs in a browser tab.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Ahmet Barış Günaydın",
    "email": "hi@barisgunaydin.com",
    "url": "https://github.com/abgnydn"
  },
  "homepage": "https://webgpu-q.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/abgnydn/webgpu-q.git"
  },
  "bugs": {
    "url": "https://github.com/abgnydn/webgpu-q/issues"
  },
  "keywords": [
    "webgpu",
    "quantum-chemistry",
    "coupled-cluster",
    "ccsd-t",
    "eom-ccsd",
    "density-functional-theory",
    "density-fitting",
    "matrix-product-states",
    "dmrg",
    "kernel-fusion",
    "in-browser",
    "reproducible-research"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ experiments/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "benchmarks:render": "tsx benchmarks/render.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@webgpu/types": "^0.1.50",
    "eslint": "^9.0.0",
    "playwright": "^1.59.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
